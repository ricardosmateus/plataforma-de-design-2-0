{
  "name": "plataforma-de-design-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de autenticação da Plataforma de Design 2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc",
    "start": "node dist/servidor.js",
    "migrar": "prisma migrate deploy",
    "migrar:dev": "prisma migrate dev",
    "gerar": "prisma generate",
    "preteste": "tsx scripts/migrar-teste.ts",
    "teste": "tsx --test --test-concurrency=1 testes/*.test.ts",
    "preteste:integracao": "tsx scripts/migrar-teste.ts",
    "teste:integracao": "tsx --test testes/transicao-integracao.test.ts",
    "relatorio:consumo": "tsx scripts/relatorio-consumo.ts",
    "creditar": "tsx scripts/creditar.ts",
    "preteste:razao": "tsx scripts/migrar-teste.ts",
    "teste:razao": "tsx --test testes/razao-integracao.test.ts",
    "preteste:reserva": "tsx scripts/migrar-teste.ts",
    "teste:reserva": "tsx --test testes/reserva-integracao.test.ts",
    "comparar-pesquisa": "tsx scripts/comparar-provedores.ts",
    "preteste:pesquisa": "tsx scripts/migrar-teste.ts",
    "teste:pesquisa": "tsx --test testes/pesquisa-integracao.test.ts",
    "simular-pagamento": "tsx scripts/simular-pagamento.ts",
    "reconciliar": "tsx scripts/reconciliar-mercado-pago.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "fastify": "^5.12.1",
    "jose": "^6.1.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
