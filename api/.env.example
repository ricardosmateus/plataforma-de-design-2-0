# ============================================================
# Configuração da API — copie para .env e preencha
# ============================================================

NODE_ENV=development
PORTA=3333

# Postgres. Em produção use a string COM pooler (Neon já fornece).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/plataforma?schema=public"

# Banco à parte para os testes de integração — NUNCA aponte para o
# mesmo banco de DATABASE_URL. Os testes APAGAM linhas; desde
# 02/09/2026 scripts/migrar-teste.ts aborta se os dois apontarem para
# o mesmo host, mas a trava é rede de segurança, não permissão.
# Ausente = os testes de integração se pulam sozinhos.
# DATABASE_URL_TESTE="postgresql://localhost:5432/plataforma_teste"

# Só se o banco de teste também for Neon (ou outro com pooler) e a
# migração travar no lock consultivo: a mesma URL acima, sem o
# "-pooler" no host. Ausente = migra pela própria DATABASE_URL_TESTE,
# que é o certo para Postgres local.
# DIRECT_URL_TESTE="postgresql://localhost:5432/plataforma_teste"

# Segredos — gere cada um com:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# NUNCA reaproveite entre ambientes, nunca versione o .env.
JWT_SEGREDO=""
OTP_PIMENTA=""

# Origens do frontend, separadas por vírgula. Fora daqui a API recusa.
ORIGENS="http://localhost:3333,http://localhost:8000"

# Argon2id — OWASP: m=19456, t=2, p=1 é o mínimo.
# Suba a memória se o servidor aguentar (65536 = 64 MiB).
ARGON_MEMORIA=19456
ARGON_ITERACOES=2
ARGON_PARALELISMO=1

# Tempos de vida
ACESSO_MINUTOS=15
REFRESH_DIAS_LEMBRAR=30
REFRESH_HORAS_SESSAO=12
DISPOSITIVO_DIAS=90
OTP_MINUTOS=10
OTP_MAX_TENTATIVAS=5
LOGIN_MAX_TENTATIVAS=3
LOGIN_JANELA_SEGUNDOS=30

# E-mail: console escreve o código no log; resend envia de verdade.
EMAIL_DRIVER=console
RESEND_API_KEY=""
EMAIL_REMETENTE="Plataforma de Design <nao-responda@seu-dominio.com>"

# Conferência contra vazamentos (k-anonymity do HIBP). "nao" em ambiente sem rede.
VERIFICAR_VAZAMENTO=sim

# Servir o frontend pela própria API: um processo só, uma porta só.
# Sem declarar, liga em desenvolvimento e desliga em produção (onde
# o frontend vai para CDN). Só arquivos .html e as pastas css/, js/
# e img/ são expostos — o resto do repositório, inclusive este .env,
# fica inacessível por HTTP.
# SERVIR_FRONTEND=sim

# Só em produção, quando API e frontend dividem domínio-pai.
# COOKIE_DOMINIO=".plataformadedesign.com"

# ---------- Créditos (Fase 0: medir, sem cobrar) ----------
# Cotação usada para converter o custo do provedor (dólar) em real.
# Número de configuração, não consulta — a Fase 1 troca pela PTAX do
# Banco Central. Ficar desatualizado NÃO corrompe o histórico: cada
# linha grava o custo em dólar E a cotação usada, então o valor em
# real se recalcula depois.
COTACAO_USD_BRL="5.40"

# ---------- Créditos (Fase 2: cobrar de verdade) ----------
# "sim" em produção, sempre. Com "nao", a IA responde normalmente mas
# nada sai do saldo de ninguém — útil só para testar sem recarregar
# saldo de teste toda hora.
CREDITOS_COBRAR="sim"

# Assina o webhook de pagamento Pix (SEG-PAG-001). Gere um por
# ambiente, nunca reaproveite: `openssl rand -hex 32`.
WEBHOOK_PIX_SECRET=""

# Identidade do recebedor que aparece no BR Code. Em sandbox, uma
# chave de teste — nunca uma chave real até a Fase 4.
PIX_CHAVE_SANDBOX="sandbox@plataformadedesign.com"
PIX_NOME_RECEBEDOR="Plataforma de Design"
PIX_CIDADE_RECEBEDOR="Sao Paulo"

# ---------- Pix — Fase 4 (Mercado Pago, decisão C3) ----------
# "sandbox" (padrão) é o PSP falso acima — nenhuma rede envolvida.
# "mercado_pago" liga o provedor de verdade e passa a EXIGIR as duas
# variáveis abaixo.
PSP_DRIVER="sandbox"

# Suas integrações → Credenciais, no painel do Mercado Pago.
# Em teste começa com TEST-, em produção com APP_USR-.
# NUNCA commitar o valor real — só este arquivo de exemplo é versionado.
MERCADO_PAGO_ACCESS_TOKEN=""

# Webhooks → Configurar notificações, no mesmo painel — a "chave
# secreta" que valida a assinatura x-signature (SEG-PAG-001).
MERCADO_PAGO_WEBHOOK_SECRET=""

# ------------------------------------------------------------
# Pesquisa de concorrentes
# planejamento-pesquisa-concorrentes.md
# ------------------------------------------------------------
# Duas capacidades separadas, e dá para ligar uma sem a outra:
#   PESQUISA_DRIVER — responde fato com fonte ("quantas unidades no
#                     Brasil"). Nível 'busca'.
#   LUGARES_DRIVER  — responde quantas unidades existem num raio
#                     ("no meu bairro"). Nível 'lugares'.
#
# "none" (padrão) recusa com mensagem clara, sem derrubar nada — o
# resto da plataforma funciona sem pesquisa configurada.
#
# Os dois só aceitam "none" por enquanto: QUAL provedor usar ainda é
# decisão em aberto (§8 do planejamento). Um valor para provedor não
# escolhido seria encenação, e encenação já custou caro neste projeto.
# "claude" usa a ferramenta web_search da Messages API com a MESMA
# IA_API_KEY do assistente — não entra fornecedor novo, e o custo já cai
# em consumos_ia/precos.ts. Escolhido em 02/09/2026 pela comparação.
PESQUISA_DRIVER="none"
LUGARES_DRIVER="none"

# Chaves dos CANDIDATOS a provedor de busca. Elas não ligam nada em
# produção — servem só ao comparador:
#
#   npm run comparar-pesquisa -- "<contexto>" "<um concorrente>"
#
# Ele roda as perguntas reais do §1 do planejamento contra cada
# candidato configurado e grava um markdown com as respostas lado a
# lado. Todos têm faixa gratuita suficiente para a comparação
# (Perplexity cobra por uso; Tavily e Exa dão 1.000 buscas/mês).
#
# Depois de decidir, o vencedor vira uma classe atrás de
# `ProvedorBusca` e passa a valer por PESQUISA_DRIVER.
# PERPLEXITY_API_KEY=""
# TAVILY_API_KEY=""
# EXA_API_KEY=""

# ---------------------------------------------------------------
# IA
# ---------------------------------------------------------------
IA_DRIVER=anthropic
IA_API_KEY=""
# Modelo padrão: classificação, segmentação de recortes e leitura
# guiada — tarefas de rotular, não de escrever.
IA_MODELO=claude-haiku-4-5-20251001
# Modelo das etapas que EXTRAEM dado do texto (Fase 2 — gráficos).
# Sem ele a Fase 2 devolve `sem-ia` e nunca gera gráfico nenhum.
# Qualquer snapshot coberto por `precos.ts` serve.
IA_MODELO_SONNET=claude-sonnet-4-5-20250929
