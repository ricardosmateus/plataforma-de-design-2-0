      <!-- Painel do grafo: o conteúdo do canvas em HTML navegável -->
      <aside class="gp" id="grafoPainel" hidden
             role="dialog" aria-labelledby="grafoPainelTitulo">
        <div class="gp-head">
          <div class="gp-head-text">
            <h3 class="gp-titulo" id="grafoPainelTitulo"></h3>
            <p class="gp-meta" id="grafoPainelMeta"></p>
          </div>
          <button type="button" class="gp-fechar" id="grafoPainelFechar" aria-label="Fechar painel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
